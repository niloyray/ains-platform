# Copy to .env (gitignored). Names only; never commit values.
# Claude Max subscription token from `claude setup-token`; passed only into `claude -p` subprocesses.
CLAUDE_CODE_OAUTH_TOKEN=
# GitHub classic PAT (repo, workflow) for the niloyray account; used by gh inside the container.
GITHUB_TOKEN=
GH_TOKEN=
# Jira Cloud
JIRA_BASE_URL=https://rayniloy.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Orchestrator
AINS_POLL_SECONDS=60
AINS_WORK_DIR=/work
# Must stay unset: any ANTHROPIC_* variable would make headless Claude Code bill the API instead of the subscription.
